function magneticVisualTab(app, magPanel, controlPanel, mapPanel)
% PLOT_MAG_SITES - Main magnetic field UI plot manager
% Plots magnetic time series and frequency content for selected sites,
% allows brushing, cleaning, and dynamic UI feedback.

%% === Step 1: Initial Validation and Panel Cleanup ===
    if nargin < 4 || isempty(magPanel) || ~isvalid(magPanel)
        warning("Invalid or missing panel.");
        return;
    end
    delete(allchild(magPanel));
    delete(allchild(controlPanel));
    delete(allchild(mapPanel));

    if ~isfield(app, "b_original")
        app.b_original = app.b_cleaned;
    end

%% === Step 2: Control Panel Setup ===
    controlGrid = uigridlayout(controlPanel, [5 1]);
    controlGrid.RowHeight = {'fit', 'fit', 'fit'};
    controlGrid.Padding = [5 5 5 1];

    % Reset Button
    uibutton(controlGrid, 'Text', 'Reset b', ...
        'ButtonPushedFcn', @(~,~) reset_b_data());

    % Delete Brushed Button (interpolates brushed points)
    uibutton(controlGrid, 'Text', 'Delete Brushed Points', ...
        'ButtonPushedFcn', @(~,~) delete_brushed_points(app, app.siteIndices, magPanel, mapPanel));

    % Export b
        uibutton(controlGrid, 'Text', 'Export b', ...
        'ButtonPushedFcn', @(~,~) export_b(app, app.b_cleaned));
    
    % Remove Mag Site Button
    uibutton(controlGrid, 'Text', 'Remove Mag Site', ...
        'ButtonPushedFcn', @(~,~) remove_mag_site(app, app.siteIndices, magPanel, mapPanel));
        
    % Edit Status Lamp
    app.EditLamp = uilamp(controlGrid);
    app.EditLamp.Color = [0 1 0];  % Green by default (no edits)
    app.EditLamp.Layout.Row = 5;



%% === Step 3: Initial Plot Rendering ===
    replot_mag_time_and_freq(app, app.siteIndices, magPanel);
    replot_mag_map(app, app.siteIndices, mapPanel);

    % Enable global brushing for user interaction
    brush(app.UIFigure, 'on');

%% === Reset Button Logic ===
    function reset_b_data()
        app.b_cleaned = app.b_original;
        app.b_freq = conv_to_freqD(app.b_cleaned, app.freqmenu);
        assignin('base', 'b_cleaned', app.b_cleaned);
        app.EditLamp.Color = [0 1 0];  % Green (reset)

        % Refresh both plot areas only
        replot_mag_time_and_freq(app, app.siteIndices, magPanel);
        replot_mag_map(app, app.siteIndices, mapPanel);
        app.StatusTextArea.Value = "🔁 b reset to original.";
    end
end

function remove_mag_site(app, siteIndices, magPanel, mapPanel)
    % Prompt for site selection
    
    if isempty(siteIndices)
        uialert(app.UIFigure, "No magnetic sites available to remove.", "Remove Site");
        return;
    end
    
    % If user provided multiple site indices, warn and confirm single removal
    if numel(siteIndices) > 1
        selection = uiconfirm(app.UIFigure, ...
            "Multiple sites selected. Are you sure?.", ...
            "Multiple Sites Detected", ...
            'Options', {'Yes','Cancel'}, 'DefaultOption', 1);
        if strcmp(selection, 'Cancel')
            return;
        end
    end
    sel = siteIndices;


    % Remove site from app data structures if present
    if ~isempty(app.b_cleaned) && ismatrix(app.b_cleaned)
        if sel <= size(app.b_cleaned, 2)
            app.b_cleaned(:,sel) = [];
        end
    end
    if ~isempty(app.b_freq) && ismatrix(app.b_freq)
        if sel <= size(app.b_freq, 2)
            app.b_freq(:,sel) = [];
        end
    end
    
     
    app.SiteListBox.Items = string({app.b_cleaned.site});
    replot_mag_time_and_freq(app, siteIndices, magPanel);
    replot_mag_map(app, siteIndices, mapPanel);
    app.EditLamp.Color = [1 0.6 0];  % indicate change (orange)
    app.StatusTextArea.Value = sprintf("🗑️ Removed mag site number %s.", string(sel));
end
