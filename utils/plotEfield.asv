function emaxT=plotEfield(app, b, subLat, subLon)
% Plot E-field at time of maximum total magnitude over time

% --- Basic checks ---
if ~isprop(app,'ex') || ~isprop(app,'ey') || isempty(app.ex)
    return;
end

ex = app.Ex_s;
ey = app.Ey_s;

% % --- Ensure rows = time ---
% if exist('b','var') && ~isempty(b) && isfield(b(1),'times')
%     T = numel(b(1).times);
%     if size(ex,1) ~= T && size(ex,2) == T
%         ex = ex.';
%         ey = ey.';
%     end
% end

% --- Find peak E over time ---
[~, idx] = max(sum(hypot(ex, ey), 2));
% --- Grab time of idx and store it as a string ---
emaxT = '';
if exist('b','var') && ~isempty(b) && isfield(b(1),'times')
    % Determine which element of b contains times for this dataset.
    times = b(1).times;
    if numel(times) >= idx
        ti = times(idx);
        % Convert datetime or numeric time to a compact string
        if isa(ti,'datetime')
            emaxT = datestr(ti);         % datetime -> string
        elseif isnumeric(ti)
            emaxT = num2str(ti);        % numeric -> string
        else
            emaxT = char(ti);           % fallback for char/cellstr
        end
    end
end

% --- Extract snapshot ---
ex_t = ex(idx,:);
ey_t = ey(idx,:);

% --- Plot (north = ey, east = ex) ---

quiverm(app.lat_s, app.lon_s, ey_t(:), ex_t(:), 'r', 'AutoScale','on','AutoScaleFactor',2);
close(fig)

% Create a new figure with a map axes for geographic plotting
fig = figure('Name','E-field Snapshot','NumberTitle','off');
% Use worldmap to create map axes that fit the sensor lat/lon region
try
    ax = worldmap([min(app.lat_s(:)) max(app.lat_s(:))], [min(app.lon_s(:)) max(app.lon_s(:))]);
catch
    % Fallback to worldmap of the world if region is invalid
    ax = worldmap('world');
end
% Move the quiver plot into the new map axes
% quiverm returns a handle when called; retrieve it from current axes if needed
h = findobj(gcf,'Type','Quiver');
if isempty(h)
    % If previous quiverm plotted in a different figure, replot on this map
    axesm(ax);
    quiverm(app.lat_s, app.lon_s, ey_t(:), ex_t(:), 'r', 'AutoScale','on','AutoScaleFactor',2);
else
    % If quiverm exists, reparent it to the new axes
    for k = 1:numel(h)
        set(h(k),'Parent',ax);
    end
end

% Enhance map with coastlines and title
coast = load('coastlines');
geoshow(ax, coast.coastlat, coast.coastlon, 'DisplayType','line','Color','k');
title(ax, ['E-field at peak time: ' emaxT]);


end
